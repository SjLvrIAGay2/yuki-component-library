{
  "name": "@yuki-ui/react",
  "version": "0.1.0",
  "description": "Yuki UI — a calm, token-driven React component library.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/yuki-ui.css"
    },
    "./tokens.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./locale": {
      "types": "./dist/locale/index.d.ts",
      "import": "./dist/locale/index.js"
    },
    "./package.json": "./package.json",
    "./ai-guide.md": "./dist/AI-GUIDE.md",
    "./animation": {
      "types": "./dist/animation/index.d.ts",
      "import": "./dist/animation/index.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run gen && npm run typecheck && vite build && node ../../scripts/postbuild.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "gen": "node ../../scripts/generate.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/hast": "^3.0.5"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "6.3.289",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
